# Terraform working data and local plans can contain sensitive infrastructure details.
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfplan.json
**/*.tfvars
**/*.tfvars.json
# Generated from terraform.backend in nexusops.yaml.
infrastructure/backend.tf.json
**/.aws/
**/.env
**/.env.*
!**/.env.example
**/credentials
**/credentials.*
**/*.pem
**/*.key
crash.log
crash.*.log

# Python bytecode and test caches.
.venv/
.tmp/
__pycache__/
*.py[cod]
.pytest_cache/

# Generated by run_nexusops.py render-k8s.
build/

# Written by the web UI when saving nexusops.yaml.
nexusops.yaml.bak
nexusops.yaml.tmp

# Web UI dependencies and build output.
node_modules/
webui/frontend/dist/
